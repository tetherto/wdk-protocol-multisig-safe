{
  "name": "@tetherto/wdk-protocol-multisig-safe",
  "version": "1.0.0-beta.1",
  "description": "A simple package to manage Safe Protocol multisig wallets with ERC-4337 account abstraction for EVM blockchains",
  "keywords": [
    "wdk",
    "wallet",
    "multisig",
    "safe",
    "gnosis",
    "erc-4337",
    "account-abstraction",
    "ethereum"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/tetherto/wdk-protocol-multisig-safe.git"
  },
  "main": "index.js",
  "type": "module",
  "types": "./types",
  "scripts": {
    "build:types": "tsc",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
    "test:integration:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/integration --coverage"
  },
  "dependencies": {
    "@safe-global/api-kit": "4.0.1",
    "bare-fetch": "^2.7.1",
    "@safe-global/types-kit": "3.0.0",
    "@tetherto/wdk-wallet": "github:quocle108/wdk-wallet#add-interface-multisig-account-wallet",
    "@tetherto/wdk-wallet-evm": "^1.0.0-beta.3",
    "@wdk-safe-global/relay-kit": "4.1.4",
    "bare-node-runtime": "^1.1.4",
    "ethers": "6.14.4"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "dotenv": "17.2.3",
    "jest": "29.7.0",
    "standard": "17.1.2",
    "typescript": "5.8.3"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "standard": {
    "ignore": [
      "bare.js",
      "tests/**/*.js"
    ]
  }
}
